{
  "name": "ncrm-kazpost",
  "version": "0.1.0",
  "private": true,
  "description": "NCRM ↔ Казпочта tracking integration with Telegram reports",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "ncrm:inspect": "tsx --env-file=.env scripts/ncrm-inspect.ts",
    "pilot:candidates": "tsx --env-file=.env scripts/pilot-candidates.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "croner": "^11.0.0",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
