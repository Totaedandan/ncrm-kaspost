NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncrm_kazpost
TZ_REPORTS=Asia/Almaty

CRM_DRIVER=mock            # mock | ncrm
# account host, e.g. cloud.ncrm.pro or acme.ncrm.kz
NCRM_BASE_URL=
# personal API token: NCRM profile -> "Ваш API token"
NCRM_API_KEY=
# where the track code lives: comments (newest comment containing a track) | field
NCRM_TRACK_SOURCE=comments
# only with NCRM_TRACK_SOURCE=field: id of the track custom field
NCRM_TRACK_FIELD_ID=
# stage id of the "НА ДОСТАВКЕ" column: only its deals are tracked, and a deal is moved only while it is still there
# ids of stages and custom fields: `pnpm ncrm:inspect`
NCRM_SOURCE_STAGE_ID=
# pilot: track only these deal ids (comma separated); empty = every deal of the source stage
NCRM_ONLY_DEAL_IDS=
NCRM_DELIVERY_FIELD_ID=
# value of the delivery field that means Kazpost (needs NCRM_DELIVERY_FIELD_ID)
NCRM_KAZPOST_DELIVERY_VALUE=
# internal status -> NCRM stage id; DELIVERED = id of the "УСПЕШНО ДОСТАВЛЕН" stage (required for ncrm)
CRM_STATUS_MAP={"DELIVERED":"","RETURNED":""}
CRM_ADD_COMMENT=false

KAZPOST_BASE_URL=https://track.kazpost.kz/api/v2
KAZPOST_CONCURRENCY=3
KAZPOST_MIN_INTERVAL_MS=300
TRACK_CODE_REGEX=^[A-Z]{2}\d{9}[A-Z]{2}$
# when all active shipments are checked and the report is sent, in TZ_REPORTS time (default: once a day at 08:00 Almaty)
POLL_CRON=0 8 * * *
# jobs to run once right after startup (comma separated, in order), e.g. sync-crm,poll-tracking,push-crm,dispatch-notifications
RUN_ON_START=
# upper bound of shipments checked per run
POLL_BATCH_SIZE=1000
# /health turns 503 when no poll succeeded for this many hours (gap between runs + slack)
HEALTH_POLL_STALE_HOURS=26

STUCK_IN_OFFICE_DAYS=5
NO_UPDATES_DAYS=10

# Without TELEGRAM_BOT_TOKEN notifications are only logged (allowed outside production)
# Token from @BotFather. Setup steps: docs/TELEGRAM_SETUP.md
TELEGRAM_BOT_TOKEN=
# polling (default): the service asks Telegram for updates, no public URL or domain needed - use it locally and on a VPS
# webhook: Telegram calls the service; needs HTTPS on a public domain, TELEGRAM_PUBLIC_URL and TELEGRAM_WEBHOOK_SECRET
TELEGRAM_MODE=polling
# only for TELEGRAM_MODE=webhook. Secret: only A-Z a-z 0-9 _ - ; used in the webhook path and as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_URL=
# chats that get status messages and the daily report (comma separated; a group id is negative)
TELEGRAM_REPORT_CHAT_IDS=
# developer alerts; empty = the first id of TELEGRAM_ADMIN_IDS (private chat)
TELEGRAM_DEV_CHAT_ID=
# users who may use /track /report /stuck /health. Send /id to the bot to learn yours
TELEGRAM_ADMIN_IDS=
# statuses announced to the report chats as they happen (others are tracked silently and appear in the daily report)
# empty = DELIVERED (the rest is in the summary after each poll). All: REGISTERED,IN_TRANSIT,ARRIVED_AT_OFFICE,DELIVERED,RETURNING,RETURNED
TELEGRAM_NOTIFY_STATUSES=
